{
  "name": "lightroom-agent",
  "version": "0.1.0-rc.4",
  "description": "Let an AI agent cull, develop, mask and export your photos in Adobe Lightroom Classic, and check every change on Lightroom's own render.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lightroom-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "LightroomAgent.lrplugin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/generate-skill.mjs && tsc -p tsconfig.build.json && node scripts/generate-contract.mjs",
    "check": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings src tests",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "prepack": "npm run build && node scripts/stage-package.mjs",
    "postpack": "node scripts/stage-package.mjs --remove"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lightroom",
    "lightroom-classic",
    "photography",
    "claude",
    "codex",
    "chatgpt",
    "pi-package"
  ],
  "author": "fadedDexofan",
  "contributors": [
    "Marcin Skalski"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fadedDexofan/lightroom-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadedDexofan/lightroom-agent.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/fadedDexofan/lightroom-agent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "jpeg-js": "0.4.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.0.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "ts-jest": "^29.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "mcpName": "io.github.fadedDexofan/lightroom-agent",
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
