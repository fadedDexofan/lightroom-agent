{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fadedDexofan/lightroom-agent",
  "description": "Let an AI agent cull, develop, mask and export photos in Lightroom Classic, render-checked",
  "repository": {
    "url": "https://github.com/fadedDexofan/lightroom-agent",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lightroom-agent",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LIGHTROOM_AGENT_REQUEST_PORT",
          "description": "Lightroom plugin request socket port.",
          "isRequired": false,
          "format": "number",
          "default": "58763"
        },
        {
          "name": "LIGHTROOM_AGENT_RESPONSE_PORT",
          "description": "Lightroom plugin response socket port.",
          "isRequired": false,
          "format": "number",
          "default": "58764"
        },
        {
          "name": "LIGHTROOM_AGENT_TOOLSETS",
          "description": "Toolsets to enable: core is always on; add develop, masks, develop,masks, or all.",
          "isRequired": false,
          "format": "string",
          "default": "all"
        },
        {
          "name": "LIGHTROOM_AGENT_READ_ONLY",
          "description": "List and accept only read tools from the enabled toolsets.",
          "isRequired": false,
          "format": "boolean",
          "default": "false"
        }
      ]
    }
  ]
}
