{
  "name": "lightroom-agent",
  "version": "0.2.1",
  "description": "Let an AI agent cull, develop, mask and export your photos in Adobe Lightroom Classic, and check every change on Lightroom's own render.",
  "author": {
    "name": "fadedDexofan"
  },
  "homepage": "https://github.com/fadedDexofan/lightroom-agent#readme",
  "repository": "https://github.com/fadedDexofan/lightroom-agent",
  "license": "MIT",
  "keywords": [
    "lightroom",
    "lightroom-classic",
    "photography",
    "mcp",
    "skills"
  ],
  "mcpServers": {
    "lightroom": {
      "command": "npx",
      "args": [
        "-y",
        "lightroom-agent@0.2.1"
      ],
      "env": {
        "LIGHTROOM_AGENT_TOOLSETS": "all"
      }
    }
  }
}
